# sudoers drop-in for the poster's put-only route (ai-tools-alerts#w75s, nfm3, vzc3).
# Installed at /etc/sudoers.d/aitools-poster, root-owned, mode 440. Replace
# RELAY_USER with the relay VM's login user (the owner of ~/bin/mirror-put),
# check the file with `visudo -cf <file>`, then move it into place.
# The command has no wildcard: sudo matches it whole. ops/vm/aitools-poster-shell
# is the strict check. sudo resets the environment and sets HOME to RELAY_USER's home.
aitools-poster ALL=(RELAY_USER) NOPASSWD: /home/RELAY_USER/bin/mirror-put checkpoint
