#!/bin/bash
# aitools-poster-shell: the login shell of the relay VM's `aitools-poster` Unix
# user, which the ai-tools-alerts poster logs in as with its own ssh key. sshd
# runs the login shell as `<shell> -c "<client command>"`; interactive logins
# get no -c and are refused. One command shape is allowed:
#   /home/<relay user>/bin/mirror-put checkpoint
# (aitools_alerts.poster.transport.put). It stores the signed feed checkpoint
# for the mirror exporter, which verifies it before publishing (ops/vm/mirror-put),
# and runs as the relay user through one sudoers rule. The route holds no key:
# the poster signs posts and checkpoints on its own machine and sends posts to
# the relay over HTTPS (ai-tools-alerts#vzc3 retired the buzz-send shape). The
# relay user's name is the one line of /etc/aitools-poster/relay-user, written
# on the VM and not tracked (the public repo does not name it).
# Source of truth: ops/vm/aitools-poster-shell in the alerts repo. The hex
# checks list their characters: a range's meaning follows the locale's
# collation, and the client sends the locale.
set +x
set -euo pipefail
umask 077
RELAY_USER_FILE=/etc/aitools-poster/relay-user
fail() {
  local msg="${1//[[:cntrl:]]/?}"; msg="${msg//\\/\\\\}"; msg="${msg//\"/\\\"}"
  printf '{"error":"user_error","message":"aitools-poster-shell: %s"}\n' "$msg" >&2
  exit 1
}
[ -f "$RELAY_USER_FILE" ] || fail "refused: relay user file missing ($RELAY_USER_FILE)"
RELAY_USER=""
# The whole file: read -d '' stops early (status 0) only at a NUL, which bash would otherwise drop.
# One trailing newline is allowed; 2>/dev/null precedes < so an unreadable file is refused quietly.
{ ! IFS= read -r -d '' RELAY_USER; } 2>/dev/null < "$RELAY_USER_FILE" \
  && RELAY_USER="${RELAY_USER%$'\n'}" \
  && [[ "$RELAY_USER" =~ ^[abcdefghijklmnopqrstuvwxyz_][abcdefghijklmnopqrstuvwxyz0123456789_-]{0,31}$ ]] \
  || fail "refused: relay user file is not one user name ($RELAY_USER_FILE)"
PUT="/home/$RELAY_USER/bin/mirror-put"
[ "$#" -eq 2 ] && [ "$1" = "-c" ] || fail "refused: interactive login (this user runs one command shape only)"
cmd="$2"
[ -n "$cmd" ] || fail "refused: empty command"
# python3 splits; a pipeline (pipefail, lastpipe) so its exit status decides, and
# a NUL after each argument so a quoted newline cannot rebuild an allowed shape.
shopt -s lastpipe 2>/dev/null || fail "refused: unparsable command (needs bash 4.4 or later)"
python3 -I -c 'import shlex,sys; [print(a, end="\0") for a in shlex.split(sys.argv[1])]' "$cmd" 2>/dev/null \
  | mapfile -d '' -t argv || fail "refused: unparsable command"
n=${#argv[@]}
# The one shape: exactly these two words, compared whole.
[ "$n" -eq 2 ] || fail "refused: argument count $n"
[ "${argv[0]}" = "$PUT" ] || fail "refused: program ${argv[0]}"
[ "${argv[1]}" = "checkpoint" ] || fail "refused: argument 2"
exec sudo -n -u "$RELAY_USER" -- "$PUT" checkpoint
