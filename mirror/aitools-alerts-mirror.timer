# systemd user timer (relayuser on the relay VM): systemctl --user enable --now
# aitools-alerts-mirror.timer. Needs linger for relayuser to run with no session.
[Unit]
Description=Export the ai-tools alert mirror every 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
