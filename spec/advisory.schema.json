{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joi/ai-tools-alerts/blob/main/spec/advisory.schema.json",
  "title": "aitools-alert advisory block",
  "description": "The JSON in the last ```aitools-alert fenced block of a post. aitools_alerts/schema.py enforces this contract by hand. Enforced by the parser only, because JSON Schema cannot express them: duplicate keys are rejected; non-standard constants (NaN, Infinity) and nesting deep enough to exhaust the decoder are rejected; free-text strings (title, advisory_severity, product name) contain no characters of Unicode categories Cc, Cf (including bidi and zero-width controls), Cs, Zl or Zp; expires_at >= posted_at; the whole block is at most 65536 UTF-8 bytes; source urls have a host; an action target or value never contains ' -' or '..'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "aliases", "level", "advisory_severity", "title", "products", "actions", "sources", "posted_by", "posted_at", "expires_at"],
  "properties": {
    "id": {"$ref": "#/$defs/ident"},
    "aliases": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/ident"}},
    "level": {"enum": ["critical", "high", "notice"]},
    "advisory_severity": {"type": ["string", "null"], "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "products": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/product"}},
    "actions": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/action"}},
    "sources": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/source"}},
    "posted_by": {"enum": ["curator", "relay-bot"], "description": "Shape only: the CLI sets the role from the trust manifest, never from this field."},
    "posted_at": {"type": "integer", "minimum": 0, "maximum": 253402300799},
    "expires_at": {"type": ["integer", "null"], "minimum": 0, "maximum": 253402300799}
  },
  "$defs": {
    "ident": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "name": {"type": "string", "pattern": "^(@[A-Za-z0-9][A-Za-z0-9._-]{0,63}/)?[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "not": {"pattern": "\\.\\."}},
    "arg": {"type": "string", "pattern": "^[A-Za-z0-9~/.@][A-Za-z0-9 ._:/@+~=,-]{0,199}$"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ecosystem", "affected", "fixed"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "ecosystem": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "affected": {"type": ["string", "null"], "pattern": "^(\\*|(<=|>=|<|>|=)[0-9]{1,9}(\\.[0-9]{1,9}){0,4}([a-z][a-z0-9]{0,15})?(,(<=|>=|<|>|=)[0-9]{1,9}(\\.[0-9]{1,9}){0,4}([a-z][a-z0-9]{0,15})?){0,3})$"},
        "fixed": {"type": ["string", "null"], "pattern": "^[0-9]{1,9}(\\.[0-9]{1,9}){0,4}([a-z][a-z0-9]{0,15})?$"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "target", "value"],
      "properties": {
        "verb": {"enum": ["upgrade", "disable_skill", "remove_mcp_server", "rotate_credential", "stop_using", "review_setting"]},
        "target": {"$ref": "#/$defs/arg"},
        "value": {"anyOf": [{"$ref": "#/$defs/arg"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"verb": {"enum": ["disable_skill", "remove_mcp_server"]}}},
         "then": {"properties": {"target": {"$ref": "#/$defs/name"}}}},
        {"if": {"properties": {"verb": {"const": "upgrade"}}},
         "then": {"properties": {"value": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/product/properties/fixed"}]}}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "published_at"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://", "maxLength": 2048},
        "published_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[0-9T:.+Z-]{0,32}$"}
      }
    }
  }
}
