{
  "version": 4,
  "match_mode": "word",
  "description": "Products in scope. Tier 1 is interrupt-eligible; tier 2 is feed only and never posts critical. Items outside both tiers do not post. match: lowercase patterns tested against the NFKC-normalised, lowercased product text. match_mode word: a pattern matches where it occurs with no letter or digit touching an edge of it that is itself a letter or digit, so skills.sh does not match skills.shopify and docker does not match dockerfile; a word-final edge also ends at one plural s (mcp server matches mcp servers) or, after a letter, where a digit starts a glued version (openssh matches openssh9.8p1); and an edge that is punctuation (@scope/, a trailing /) needs no boundary. not_match (optional): an entry does not match where any of these patterns also matches by the same rule, so a library for Node.js is not Node.js; a not_match pattern names a third-party product, never a phrase the vendor's own advisory could use. components (optional): a list of {name, match, not_match?}, each a public product identity a member's inventory can report; they are tried in order before the entry's own match, and the first that matches (and is not vetoed by its own not_match) is the product a post names, its upgrade target and its thread key; the entry's match, when present, is the fallback under the entry's name; the entry's not_match vetoes either. An entry has match, components or both. Entry and component names are unique across the file; a component may carry its own entry's name. Version 4 is the only version a reader accepts.",
  "entries": [
    {"name": "Claude Code", "ecosystem": "claude-code", "tier": 1, "match": ["claude code", "claude-code", "@anthropic-ai/claude-code"]},
    {"name": "Codex", "ecosystem": "codex", "tier": 1, "match": ["openai codex", "codex cli", "codex-cli", "openai/codex", "@openai/codex"]},
    {"name": "Cursor", "ecosystem": "cursor", "tier": 1, "match": ["cursor ide", "cursor editor", "cursor cli", "cursor-agent", "cursor/cursor", "getcursor/cursor", "anysphere", "cursor.com"]},
    {"name": "Gemini CLI", "ecosystem": "gemini-cli", "tier": 1, "match": ["gemini cli", "gemini-cli", "@google/gemini-cli"]},
    {"name": "Hermes", "ecosystem": "hermes", "tier": 1, "match": ["hermes agent", "hermes-agent", "nousresearch/hermes"]},
    {"name": "OpenClaw", "ecosystem": "openclaw", "tier": 1, "match": ["openclaw"]},
    {"name": "MCP servers and clients", "ecosystem": "mcp", "tier": 1, "match": ["model context protocol", "mcp server", "mcp client", "mcp-server", "modelcontextprotocol/"], "components": [
      {"name": "MCP Inspector", "match": ["mcp inspector", "@modelcontextprotocol/inspector", "modelcontextprotocol/inspector"]},
      {"name": "mcp-remote", "match": ["mcp-remote"]},
      {"name": "MCP TypeScript SDK", "match": ["@modelcontextprotocol/sdk", "modelcontextprotocol/typescript-sdk", "mcp typescript sdk"]},
      {"name": "MCP Python SDK", "match": ["modelcontextprotocol/python-sdk", "mcp python sdk"]}]},
    {"name": "ClawHub and skills.sh", "ecosystem": "skill", "tier": 1, "match": ["agent skill", "claude skill"], "components": [
      {"name": "ClawHub", "match": ["clawhub"]}, {"name": "skills.sh", "match": ["skills.sh"]}]},
    {"name": "Node.js", "ecosystem": "node", "tier": 1, "match": ["node.js", "nodejs"], "not_match": ["library for node.js", "library for nodejs", "node.js library", "nodejs library"]},
    {"name": "Python", "ecosystem": "python", "tier": 1, "match": ["cpython", "python software foundation"]},
    {"name": "Go", "ecosystem": "go", "tier": 1, "match": ["golang", "go toolchain", "go standard library"], "not_match": ["library for golang", "golang library"]},
    {"name": "Rust", "ecosystem": "rust", "tier": 1, "match": ["rust toolchain", "rust-lang", "rust programming language", "rust cargo", "rust rustc", "rust compiler", "cargo package manager"], "components": [{"name": "rustup", "match": ["rustup"]}]},
    {"name": "Docker", "ecosystem": "docker", "tier": 1, "components": [
      {"name": "containerd", "match": ["containerd"]},
      {"name": "runc", "match": ["opencontainers runc", "runc container runtime", "opencontainers/runc"]},
      {"name": "Docker", "match": ["docker", "moby", "dockerd"]}]},
    {"name": "Tailscale", "ecosystem": "tailscale", "tier": 1, "match": ["tailscale", "tailscaled"]},
    {"name": "OpenSSH", "ecosystem": "openssh", "tier": 1, "match": ["openssh"]},
    {"name": "git", "ecosystem": "git", "tier": 1, "match": ["git scm", "git-scm", "git for windows", "git client", "git git", "git/git"], "not_match": ["git client plugin"]},
    {"name": "macOS", "ecosystem": "macos", "tier": 2, "match": ["macos", "mac os x", "apple webkit"]},
    {"name": "Linux distributions", "ecosystem": "linux", "tier": 2, "components": [
      {"name": "Linux kernel", "match": ["linux kernel"]},
      {"name": "Ubuntu", "match": ["ubuntu"]}, {"name": "Debian", "match": ["debian"]}, {"name": "Fedora", "match": ["fedora"]}]},
    {"name": "Browsers", "ecosystem": "browser", "tier": 2, "not_match": ["extension for chrome", "extension for firefox", "add-on for firefox", "extension for safari"], "components": [
      {"name": "Chrome", "match": ["chrome"]}, {"name": "Chromium", "match": ["chromium"]},
      {"name": "Safari", "match": ["safari"]}, {"name": "Firefox", "match": ["firefox"]}]}
  ]
}
